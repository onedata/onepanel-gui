{{!-- TODO i18n --}}

{{#if spacesLoadError}}
  <ResourceLoadError
    class="alert-some-storages-rejected"
    @message="Support information may be incomplete due to spaces data load error"
    @onClose={{action (mut spacesLoadError false)}}
  />
{{/if}}

{{#if anyStorageRejected}}
  <ResourceLoadError
    class="alert-some-storages-rejected"
    @message="Some of storage details cannot be loaded properly."
    @onClose={{action (mut anyStorageRejected false)}}
  />
{{/if}}

<OneCollapsibleList as |list|>
  {{#each storages key="id" as |storage|}}
    <list.item
      @isActive={{eq storage.id openedStorageId}}
      as |listItem|
    >
      <StorageItem
        @listItem={{listItem}}
        @storageProxy={{storage}}
        @spaces={{spaces}}
        @reloadStoragesList={{reloadStoragesList}}
        @removeStorage={{action removeStorage storage.content}}
        @hideSupportSpaceButton={{hideSupportSpaceButton}}
      />
    </list.item>
  {{/each}}
</OneCollapsibleList>
