<div class="row content-row no-border">
  <h1>
    <span class="chart-title">Import files processing</span>
    <OneLabelTip
      @title="The chart shows how many files was processed with operations of given type in specific time periods"
      @placement="top"
    />
  </h1>
</div>
<div class="row content-row chart-row has-border">
  <div class="scrollable-row">
    {{#if importChartDataError}}
      <ResourceLoadError @reason={{importChartDataError}} />
    {{else}}
      <ChartistChart
        @data={{chartData}}
        @options={{chartOptions}}
        @type="bar"
        class="hide-middle-x-labels"
      />
    {{/if}}
  </div>
</div>
