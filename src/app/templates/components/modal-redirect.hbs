<OneModal
  @id="redirecting-domain"
  @open={{open}}
  @keyboard={{false}}
  @backdropClose={{false}}
  as |modal|
>
  <modal.body>
    <SpinSpinnerBlock @sizeClass="md" class="inline-centered description-bottom" />
    <p class="loading-info">{{tt this "redirectingProgress"}}</p>
  </modal.body>
</OneModal>
