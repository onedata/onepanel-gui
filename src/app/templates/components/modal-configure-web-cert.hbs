<BsModal
  @id="configure-web-cert"
  @open={{open}}
  @onHide={{action "onHide"}}
  @keyboard={{false}}
  @backdropClose={{false}}
  as |modal|
>
  <modal.header>
    <h1>
      <OneIcon @icon="sign-warning-rounded" />
      <span class="one-lable">{{tt this "title"}}</span>
    </h1>
  </modal.header>
  <modal.body>
    <p>{{tt this "text"}}</p>
  </modal.body>
  <modal.footer class="btn-toolbar">
    <OneButton @type="default" @onClick={{action modal.close}}>
      {{tt this "btnDiscard"}}
    </OneButton>
    <LinkTo
      @route="onedata.sidebar.content.aspect"
      @model="certificate"
      class="btn btn-primary"
    >
      {{tt this "btnGoToCert"}}
    </LinkTo>
  </modal.footer>
</BsModal>
