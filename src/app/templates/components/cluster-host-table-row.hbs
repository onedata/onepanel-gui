<td class="row-header truncate" {{action "headerClick" on="click"}} data-option="name">
  <span class="item-icon-container">
    <OneIcon class="item-icon" @icon="node" />
    <OneTooltip @title={{this.host.hostname}} @placement="top" @triggerEvents="hover" />
  </span>
  <span class="one-label">{{this.host.hostname}}</span>
</td>
<td class="text-center column toggle-column compact" data-option="database">
  <OneWayToggle
    @checked={{this.host.database}}
    @update={{action "checkboxChanged"}}
    @hostHostname={{this.host.hostname}}
    @hostOption="database"
    @dataOption="database"
    @lockHint={{this.togglesLockTooltip.database}}
    @isReadOnly={{this.effReadonlyServices.database}}
  />
</td>
<td class="text-center column toggle-column compact" data-option="clusterWorker">
  <OneWayToggle
    @checked={{this.host.clusterWorker}}
    @update={{action "checkboxChanged"}}
    @hostHostname={{this.host.hostname}}
    @hostOption="clusterWorker"
    @dataOption="clusterWorker"
    @lockHint={{this.togglesLockTooltip.clusterWorker}}
    @isReadOnly={{this.effReadonlyServices.clusterWorker}}
  />
</td>
<td class="text-center column toggle-column compact" data-option="clusterManager">
  <OneWayToggle
    @checked={{this.host.clusterManager}}
    @update={{action "checkboxChanged"}}
    @hostHostname={{this.host.hostname}}
    @hostOption="clusterManager"
    @dataOption="clusterManager"
    @lockHint={{this.togglesLockTooltip.clusterManager}}
    @isReadOnly={{this.effReadonlyServices.clusterManager}}
  />
</td>
<td class="text-center column toggle-column compact" data-option="primaryClusterManager">
  <OneWayToggle
    @checked={{this.isPrimaryClusterManager}}
    @update={{action "primaryClusterManagerChanged" host.hostname}}
    @hostHostname={{this.host.hostname}}
    @hostOption="primaryClusterManager"
    @dataOption="primaryClusterManager"
    @lockHint={{this.togglesLockTooltip.primaryClusterManager}}
    @isReadOnly={{this.effReadonlyServices.primaryClusterManager}}
  />
</td>
{{#if this.isOneS3Visible}}
  <td class="text-center column toggle-column compact" data-option="oneS3">
    <OneWayToggle
      @checked={{this.host.oneS3}}
      @update={{action "checkboxChanged"}}
      @hostHostname={{this.host.hostname}}
      @hostOption="oneS3"
      @dataOption="oneS3"
      @lockHint={{this.togglesLockTooltip.oneS3}}
      @isReadOnly={{this.effReadonlyServices.oneS3}}
    />
  </td>
{{/if}}
{{#if this.removeAvailable}}
  <td class="text-center column btn-column compact">
    <div>
      {{#if this.isMobile}}
        <OneButton
          @type="danger"
          @buttonType="submit"
          @size="sm"
          @onClick={{action "removeHost"}}
          @disabled={{this.isRemoveHostBtnDisabled}}
          class="btn-remove-node"
        >
          {{tt this "removeBtn"}}
        </OneButton>
      {{else}}
        <RemoveIcon
          @tooltipText={{tt this "removeBtn"}}
          @onClick={{action "removeHost"}}
          @isDisabled={{this.isRemoveHostBtnDisabled}}
          class="btn-remove-node"
        />
      {{/if}}
    </div>
  </td>
{{/if}}
