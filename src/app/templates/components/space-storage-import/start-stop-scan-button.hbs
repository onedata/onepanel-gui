<OneButton
  @type={{if showScanStop "danger" "primary"}}
  @buttonType="submit"
  @size="sm"
  @disabled={{if showScanStop (not allowScanStop) (not allowScanStart)}}
  @onClick={{if showScanStop stopScan startScan}}
>
  <OneIcon @icon={{if showScanStop "cancelled" "play"}} />
  <span class="text">{{tt this (if showScanStop "stopScan" "startScan")}}</span>
</OneButton>
