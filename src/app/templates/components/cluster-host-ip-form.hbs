<thead>
  <tr>
    <th>{{tt this "hostname"}}</th>
    <th>{{tt this "ip"}}</th>
  </tr>
</thead>
<tbody>
  {{#each _hostsData key="hostname" as |host|}}
    <ClusterHostIpForm::HostRow
      @isReadOnly={{isReadOnly}}
      @valueChanged={{action "valueChanged"}}
      @validationChanged={{action "validationChanged"}}
      @hostname={{host.hostname}}
      @ip={{host.ip}}
      @tags={{host.tags}}
    />
  {{/each}}
</tbody>
