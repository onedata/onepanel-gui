{{#if anySpaceRejected}}
  <ResourceLoadError
    class="alert-some-spaces-rejected"
    @message={{tt this "someLoadError"}}
    @onClose={{action "closeRejectedError"}}
  />
{{/if}}

<OneCollapsibleList as |list|>
  {{#each spaces as |space|}}
    {{!-- TODO: change to links, because we want to open in separate tabs --}}
    <list.item @toggle={{action "spaceClicked" listItem}} as |listItem|>
      <listItem.header
        @isCollapsible={{false}}
        @click={{action "spaceClicked" space.id}}
        class="hoverable spaces-list-item-header clickable"
      >
        <ClusterSpacesTableItem
          @space={{space}}
          @provider={{provider}}
          @startRevokeSpace={{action "startRevokeSpace"}}
        />
      </listItem.header>
    </list.item>
  {{/each}}
</OneCollapsibleList>
