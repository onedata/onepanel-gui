{{!-- TODO i18n --}}

<span class="list-header-content">
  <span class="item-icon-container">
    <OneIcon class="item-icon" @icon="space" />
    <OneTooltip @title={{space.name}} @placement="top" @triggerEvents="hover" />
  </span>
  <NameConflict @item={{space}} @tagName="span" class="one-label space-name-header" />
  <SpaceStatusIcons @space={{space}} @importInfo={{importInfo}} />
  <OneCollapsibleToolbar
    @isMinimized={{true}}
    @toggleBtnClass="btn-menu-toggle"
    as |dropdown|
  >
    <dropdown.item
      @itemAction={{action startRevokeSpace space}}
      @triggerClasses="btn-revoke-space-support"
    >
      <OneIcon @icon="browser-delete" />
      {{t "components.clusterSpacesTableItem.revokeSpaceSupport"}}
    </dropdown.item>
  </OneCollapsibleToolbar>
</span>
