<td class="row-header cell-hostname" {{action "headerClick" on="click"}} data-option="name">
  <span class="item-icon-container">
    <OneIcon class="item-icon" @icon="node" />
    <OneTooltip @title={{hostname}} @placement="top" @triggerEvents="hover" />
  </span>
  <span class="record-info-container">
    <span class="one-label">{{hostname}}</span>
    {{#each tags as |tag|}}
      <span class="label label-info">{{tag}}</span>
    {{/each}}
  </span>
</td>
<td class="cell-ip-address compact" data-option="ip-address">
  <div class="row">
    {{#if isReadOnly}}
      <span>{{ip}}</span>
    {{else}}
      <BsForm class="compact form-horizontal without-labels" as |form|>
        <form.group
          @validation={{if validationMessage "error" "success"}}
          class={{if validationMessage "has-message"}}
        >
          <input
            class="form-control input-host-ip"
            value={{ip}}
            oninput={{action "valueChanged"}}
            placeholder={{tt this "example"}}
            disabled={{isReadOnly}}
          >
          {{#if validationMessage}}
            <div class="form-message">{{validationMessage}}</div>
          {{/if}}
        </form.group>
      </BsForm>
    {{/if}}
  </div>
</td>
