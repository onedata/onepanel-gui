<div class="row content-row header-row hidden-xs">
  <h1>{{tt this "header"}}</h1>
</div>
<div class="row">
  <OneBsTab
    class="only-tab-bar bs-tab-onedata bs-tab-modern"
    @activeId={{activeTabId}}
    @onChange={{action "tabChange"}}
    @customTabs={{true}}
    as |tab|
  >
    <BsNav @type="tabs" as |nav|>
      <nav.item
        class="sign-in-notification-item"
        @active={{eq tab.activeId signInNotificationTabId}}
      >
        <a
          class="nav-link"
          role="tab" {{action tab.select signInNotificationTabId}}>
          {{tt this "tabs.signInNotification.header"}}
          {{#if guiSettingsManager.signInNotificationEmptyError}}
            <img class="warning-icon" src={{root-url "assets/images/sign-warning-large.svg"}}>
            {{#unless (media "isMobile")}}
              <OneTooltip
                @title={{tt this "tabs.signInNotification.emptyContentTabWarning"}}
                @triggerElement=".sign-in-notification-item .warning-icon"
                @triggerEvent="hover"
              />
            {{/unless}}
          {{/if}}
        </a>
      </nav.item>
      <nav.item
        class="privacy-policy-item"
        @active={{eq tab.activeId privacyPolicyTabId}}
      >
        <a
          class="nav-link"
          role="tab" {{action tab.select privacyPolicyTabId}}>
          {{tt this "tabs.privacyPolicy.header"}}
          {{#if guiSettingsManager.privacyPolicyEmptyError}}
            <img class="warning-icon" src={{root-url "assets/images/sign-warning-large.svg"}}>
            {{#unless (media "isMobile")}}
              <OneTooltip
                @title={{tt this "tabs.privacyPolicy.emptyContentTabWarning"}}
                @triggerElement=".privacy-policy-item .warning-icon"
                @triggerEvent="hover"
              />
            {{/unless}}
          {{/if}}
        </a>
      </nav.item>
      <nav.item class="terms-of-use-item" @active={{eq tab.activeId termsOfUseTabId}}>
        <a
          class="nav-link"
          role="tab" {{action tab.select termsOfUseTabId}}>
          {{tt this "tabs.termsOfUse.header"}}
          {{#if guiSettingsManager.termsOfUseEmptyError}}
            <img class="warning-icon" src={{root-url "assets/images/sign-warning-large.svg"}}>
            {{#unless (media "isMobile")}}
              <OneTooltip
                @title={{tt this "tabs.termsOfUse.emptyContentTabWarning"}}
                @triggerElement=".terms-of-use-item .warning-icon"
                @triggerEvent="hover"
              />
            {{/unless}}
          {{/if}}
        </a>
      </nav.item>
      <nav.item
        class="cookie-consent-notification-item"
        @active={{eq tab.activeId cookieConsentNotificationTabId}}
      >
        <a class="nav-link" role="tab" {{action tab.select cookieConsentNotificationTabId}}>
          {{tt this "tabs.cookieConsentNotification.header"}}
          {{#if guiSettingsManager.cookieConsentNotificationEmptyError}}
            <img class="warning-icon" src={{root-url "assets/images/sign-warning-large.svg"}}>
            {{#unless (media "isMobile")}}
              <OneTooltip
                @title={{tt this "tabs.cookieConsentNotification.emptyContentTabWarning"}}
                @triggerElement=".cookie-consent-notification-item .warning-icon"
                @triggerEvent="hover"
              />
            {{/unless}}
          {{/if}}
        </a>
      </nav.item>
    </BsNav>
    <div class="tab-content">
      <tab.pane @id={{signInNotificationTabId}}>
        <ContentClustersGuiSettings::SignInNotification />
      </tab.pane>
      <tab.pane @id={{privacyPolicyTabId}}>
        <ContentClustersGuiSettings::PrivacyPolicy />
      </tab.pane>
      <tab.pane @id={{termsOfUseTabId}}>
        <ContentClustersGuiSettings::TermsOfUse />
      </tab.pane>
      <tab.pane @id={{cookieConsentNotificationTabId}}>
        <ContentClustersGuiSettings::CookieConsentNotification />
      </tab.pane>
    </div>
  </OneBsTab>
</div>
