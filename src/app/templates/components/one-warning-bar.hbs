<div class="text-center truncate clickable" {{action "toggleInfoModal" true}}>
  <span class="one-warning-bar-title">{{text}}</span>
  <div class="inline-icon-container sm">
    <OneIcon @icon="sign-info-rounded" />
  </div>
</div>

<BsModal
  @id="one-warning-bar"
  @open={{infoOpened}}
  @onHide={{action "toggleInfoModal" false}}
  @keyboard={{true}}
  @backdropClose={{true}}
  as |modal|
>
  {{yield (hash modal=modal)}}
</BsModal>
