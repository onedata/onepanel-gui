<BsForm @submitOnEnter={{false}} class="form-horizontal" as |form|>
  <div class="import-configuration-section">
    <h2 class="form-section-title">{{tt this "importConfiguration"}}</h2>
    <OneFormFields
      @bsForm={{form}}
      @fields={{currentFields}}
      @formValues={{formValues}}
      @inputChanged={{action "inputChanged"}}
      @onFocusOut={{action "focusOut"}}
    />
  </div>
  <div class="row">
    <div class={{layoutConfig.formSubmitColumns}}>
      {{#if autoImportEnabled}}
        <p class="small continuous-info-msg">
          {{tt this (if
            continuousScanEnabled
            "continuousScanEnabledDesc"
            "continuousScanDisabledDesc"
          )}}
        </p>
      {{/if}}
      {{#if showSubmitButton}}
        <OneButton
          @type="primary"
          @buttonType="submit"
          class="submit-import"
          @disabled={{not isValid}}
          @onClick={{action "submit"}}
        >
          {{tt this (if (eq mode "new") "submitNew" "submitModify")}}
        </OneButton>
      {{/if}}
    </div>
  </div>
</BsForm>
