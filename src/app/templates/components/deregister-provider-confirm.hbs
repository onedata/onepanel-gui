<h1>{{tt this "deregisterProviderHeaderEmergency"}}</h1>
<p>{{tt this "deregistrationResults"}}</p>
<div class="btn-toolbar">
  <OneButton class="btn btn-sm" @type="info" @onClick={{closeAction}}>
    {{tt this "keepItRegistered"}}
  </OneButton>
  <OneButton @type="danger" @buttonType="submit" @size="sm" @onClick={{submitAction}}>
    <OneIcon @icon="browser-delete" /> <span>{{tt this "yesDeregister"}}</span>
  </OneButton>
</div>
