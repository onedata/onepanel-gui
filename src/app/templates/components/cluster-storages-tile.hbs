<OneTile
  @title={{tt this "title"}}
  @aspect="storages"
  class="cluster-storages-tile text-center"
>
  <PromiseProxyContainer @proxy={{storagesCountProxy}}>
    <div class="circle">
      <OneIcon @icon="support" />
      <span class="storages-number {{storagesNumberClass}}">
        {{storagesCountProxy.content}}
      </span>
    </div>
  </PromiseProxyContainer>
</OneTile>
