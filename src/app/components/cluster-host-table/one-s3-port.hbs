{{#if this.isShown}}
  <div class="one-s3-port {{unless this.valid "has-error"}}" ...attributes>
    {{#if this.usesInput}}
      <input
        type="text"
        class="form-control input-sm one-s3-port-input"
        value={{this.portValue}}
        placeholder={{tt this "port"}}
        disabled={{this.portLocked}}
        {{on "input" this.changePort}}
      >
    {{else}}
      <div class="one-s3-port-static-text">{{this.portValue}}</div>
    {{/if}}
    {{#if this.feedbackIcon}}
      <OneIcon @icon={{this.feedbackIcon}} class="one-s3-port-icon one-s3-feedback-icon">
        {{#if this.iconTooltip}}
          <OneTooltip class="tooltip-lg" @title={{this.iconTooltip}} />
        {{/if}}
      </OneIcon>
    {{/if}}
  </div>
{{/if}}