<GlobalModal
  @classNames={{concat-classes "enable-s3-modal" this.modalClass}}
  @modalId={{this.modalId}}
  @allowClose={{false}}
  as |modal|
>
  <modal.header>
    <h1>
      <OneIcon @icon="sign-info-rounded" />
      <span class="one-label">{{tt this "title"}}</span>
    </h1>
  </modal.header>
  <modal.body>
    {{#if (eq this.stateName EnableS3ModalState.Confirm)}}
      <p>{{this.introText}}</p>
      <ul>
        {{#each this.hostnames as |hostname|}}
          <li>{{hostname}}</li>
        {{/each}}
      </ul>
      <p>{{tt this "body.oneS3Deployment"}}</p>
    {{else if (eq this.stateName EnableS3ModalState.Progress)}}
      <p>{{tt this "body.deploying" step=this.currentState.stepText}}</p>
      <BsProgress as |bsProgress|>
        {{#if this.currentState.currentStepId}}
          <bsProgress.bar
            @value={{this.currentState.deployProgress}}
            @minValue={{0}}
            @maxValue={{1}}
            @showLabel={{false}}
            @type="primary"
            @animate={{true}}
          />
        {{else}}
          <bsProgress.bar
            @value={{1}}
            @minValue={{0}}
            @maxValue={{1}}
            @showLabel={{false}}
            @type="unknown"
            class="progress-bar-striped active"
          />
        {{/if}}
      </BsProgress>
    {{/if}}
  </modal.body>
  <modal.footer class="btn-toolbar">
    <OneButton
      @type="default"
      class="cancel"
      @onClick={{modal.close}}
      @disabled={{this.currentState.isCancelDisabled}}
    >
      {{tt this "buttons.cancel"}}
    </OneButton>
    <OneButton
      @type="primary"
      @buttonType="submit"
      class="proceed"
      @disabled={{this.currentState.isDeployDisabled}}
      @onClick={{this.startDeployment}}
    >
      {{tt this "buttons.deploy"}}
    </OneButton>
  </modal.footer>
</GlobalModal>